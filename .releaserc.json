{
  "branches": [
    "main"
  ],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "publishCmd": "pwsh -NoProfile -File ./build/Publish-MigrationModule.ps1 -Version ${nextRelease.version}",
        "successCmd": "pwsh -NoProfile -File ./build/Update-GitHubReleaseNotes.ps1 -Version ${nextRelease.version} -Tag ${nextRelease.gitTag}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "artifacts/packages/*.nupkg"
          },
          {
            "path": "artifacts/cli/*/Migration4Dataverse.Cli-*"
          }
        ],
        "successComment": false
      }
    ]
  ]
}
