Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

$dataDirectory = Join-Path $PSScriptRoot 'generated-data'
$outputDirectory = Join-Path $dataDirectory 'output'
$databasePath = Join-Path $dataDirectory 'migration-filter.sqlite3'
$sourcePath = Join-Path $dataDirectory 'filter-rows.jsonl'
$null = [System.IO.Directory]::CreateDirectory($dataDirectory)
if (-not (Test-Path -LiteralPath $sourcePath -PathType Leaf)) {
    $rows = @(
        '{"SourceId":"filter-row","RecordId":"00000000-0000-0000-0000-000000000002","Name":"filter-error"}'
        '{"SourceId":"survivor-row","RecordId":"00000000-0000-0000-0000-000000000005","Name":"survivor"}'
    )
    [System.IO.File]::WriteAllLines(
        $sourcePath,
        $rows,
        [System.Text.UTF8Encoding]::new($false))
}

$null = [System.IO.Directory]::CreateDirectory($outputDirectory)
$Migration = @{
    Steps = @(
        @{
            Id = 'Rows'
            Type = 'source'
            Inputs = @()
            Source = @{
                Type = 'file'
                Format = @{ Type = 'jsonl' }
                ConnectionId = 'files'
                Path = 'filter-rows.jsonl'
                Key = 'SourceId'
                Id = 'RecordId'
            }
        }
        @{
            Id = 'Filter'
            Type = 'filter'
            Inputs = @('Rows')
            Script = {
                param($row)
                if ($row.Name -eq 'filter-error') {
                    throw 'Edit or retry the filter-error row to continue.'
                }
                $true
            }
        }
        @{
            Id = 'Target'
            Type = 'target'
            Inputs = @('Filter')
            Target = @{
                Type = 'file'
                Format = @{ Type = 'jsonl' }
                ConnectionId = 'target'
                Path = 'filter-recovered-rows.jsonl'
            }
        }
    )
    Connections = @{
        files = [System.IO.DirectoryInfo]$dataDirectory
        target = [System.IO.DirectoryInfo]$outputDirectory
    }
    RunOptions = @{
        DatabasePath = $databasePath
        RunName = 'Filter row error recovery'
        BatchSize = 1
        MaxAttempts = 1
        MaxDegreeOfParallelism = 1
        EnableDebugCapture = $true
    }
}
