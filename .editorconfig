root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx,csproj,props,targets,slnx,ps1,psm1,psd1}]
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx,json,jsonc,css,html,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
