<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DashboardProjectDirectory>$(MSBuildProjectDirectory)/../../web/Migration4Dataverse.Dashboard</DashboardProjectDirectory>
    <DashboardDistDirectory>$(DashboardProjectDirectory)/dist</DashboardDistDirectory>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Migration4Dataverse.Engine.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="en-US/Migration4Dataverse.Engine.dll-Help.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <DashboardSource Include="$(DashboardProjectDirectory)/package.json;$(DashboardProjectDirectory)/package-lock.json;$(DashboardProjectDirectory)/.npmrc;$(DashboardProjectDirectory)/index.html;$(DashboardProjectDirectory)/vite.config.ts;$(DashboardProjectDirectory)/tsconfig.json;$(DashboardProjectDirectory)/src/**/*.*;$(DashboardProjectDirectory)/public/**/*.*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Azure.Storage.Files.DataLake" />
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="DuckDB.NET.Data.Full" />
    <PackageReference Include="ExcelDataReader" />
    <PackageReference Include="Google.Cloud.Storage.V1" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.PowerShell.SDK" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
    <PackageReference Include="Parquet.Net" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>

  <Target Name="BuildMigrationDashboardUi" BeforeTargets="PrepareForBuild" Inputs="@(DashboardSource)" Outputs="$(DashboardDistDirectory)/index.html">
    <Exec WorkingDirectory="$(DashboardProjectDirectory)" Command="npm ci" />
    <Exec WorkingDirectory="$(DashboardProjectDirectory)" Command="npm run build" />
  </Target>

  <Target Name="EmbedMigrationDashboardUi" BeforeTargets="PrepareForBuild" DependsOnTargets="BuildMigrationDashboardUi">
    <ItemGroup>
      <DashboardResource Include="$(DashboardDistDirectory)/**/*.*" />
      <EmbeddedResource Include="@(DashboardResource)" LogicalName="Migration4Dataverse.Engine.Dashboard.wwwroot/%(DashboardResource.RecursiveDir)%(DashboardResource.Filename)%(DashboardResource.Extension)" />
    </ItemGroup>
  </Target>

</Project>
