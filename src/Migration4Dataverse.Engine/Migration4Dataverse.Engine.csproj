<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DashboardProjectDirectory>$(MSBuildProjectDirectory)/../../web/Migration4Dataverse.Dashboard</DashboardProjectDirectory>
    <DashboardDistDirectory>$(MSBuildProjectDirectory)/Dashboard/wwwroot</DashboardDistDirectory>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Migration4Dataverse.Engine.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.6.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.7" />
    <PackageReference Include="Parquet.Net" Version="6.1.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <Target Name="BuildMigrationDashboardUi" BeforeTargets="PrepareForBuild" Inputs="$(DashboardProjectDirectory)/package.json;$(DashboardProjectDirectory)/package-lock.json;$(DashboardProjectDirectory)/index.html;$(DashboardProjectDirectory)/vite.config.ts;$(DashboardProjectDirectory)/tsconfig.json;$(DashboardProjectDirectory)/src/main.tsx;$(DashboardProjectDirectory)/src/App.tsx;$(DashboardProjectDirectory)/src/styles.css;$(DashboardProjectDirectory)/public/logo.png" Outputs="$(DashboardDistDirectory)/index.html">
    <Exec WorkingDirectory="$(DashboardProjectDirectory)" Command="npm ci" />
    <Exec WorkingDirectory="$(DashboardProjectDirectory)" Command="npm run build" />
  </Target>

  <Target Name="EmbedMigrationDashboardUi" BeforeTargets="PrepareForBuild" DependsOnTargets="BuildMigrationDashboardUi">
    <ItemGroup>
      <DashboardResource Include="$(DashboardDistDirectory)/**/*.*" />
      <EmbeddedResource Include="@(DashboardResource)" LogicalName="Migration4Dataverse.Engine.Dashboard.wwwroot/%(DashboardResource.RecursiveDir)%(DashboardResource.Filename)%(DashboardResource.Extension)" />
    </ItemGroup>
  </Target>

</Project>
