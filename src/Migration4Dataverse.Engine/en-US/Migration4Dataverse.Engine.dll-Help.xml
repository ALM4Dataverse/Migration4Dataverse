      <command:parameter><maml:name>Base64</maml:name><maml:description><maml:para>Base64-encoded content to decode and write to staging.</maml:para></maml:description></command:parameter>
      <command:parameter><maml:name>StagingRoot</maml:name><maml:description><maml:para>Directory where the staged binary content is stored.</maml:para></maml:description></command:parameter>
